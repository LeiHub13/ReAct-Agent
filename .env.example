# DeepSeek chat and web search use the same API key.
MODEL=deepseek/deepseek-flash
DEEPSEEK_API_KEY=your-deepseek-api-key
MAX_SEARCH_RESULTS=10

# To separate your traces from other application
LANGSMITH_PROJECT=react-agent

# Optional: configure the matching key if you change MODEL to another provider.

## LLM choice:
# ANTHROPIC_API_KEY=...
# FIREWORKS_API_KEY=...
# OPENAI_API_KEY=...
